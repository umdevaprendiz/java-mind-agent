{
  "name": "java-mind-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Front-end do Java Mind Agent (React + TypeScript). F32: setup e mocks; F33: layout JMA (tema preto/claro, xícaras de nível).",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:backend": "vite --mode backend",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@mswjs/interceptors": "^0.45.12",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "msw": "^3.0.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
