# Copie para ".env" (ignorado pelo git) e ajuste. Lido pelo docker compose.
# A aplicação Spring não precisa destes valores em dev: o spring-boot-docker-compose
# descobre usuário, senha e porta do container sozinho.
POSTGRES_DB=javamind
POSTGRES_USER=javamind
POSTGRES_PASSWORD=troque-esta-senha
# Porta no host (a 5432 costuma estar ocupada por um Postgres local).
POSTGRES_PORT=5433

# Opcional: URL do Ollama. Não é lida deste arquivo — defina como variável de ambiente
# do sistema se o Ollama não estiver em http://localhost:11434 (usada pela app e pelo doctor).
# OLLAMA_BASE_URL=http://localhost:11434
